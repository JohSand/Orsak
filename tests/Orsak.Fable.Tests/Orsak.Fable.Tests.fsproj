<Project Sdk="Microsoft.NET.Sdk">
    <!-- Tests that run both on .NET, with dotnet run, against Orsak's .NET implementation, and compiled with Fable and
         run on Node.js, against its Fable implementation:
             dotnet fable tests/Orsak.Fable.Tests -o tests/Orsak.Fable.Tests/out && node tests/Orsak.Fable.Tests/out/Program.js -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="Runner.fs" />
        <Compile Include="EffTests.fs" />
        <Compile Include="EffectModuleTests.fs" />
        <Compile Include="RemotingTests.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\Orsak\Orsak.fsproj" />
        <ProjectReference Include="..\..\src\Orsak.Remoting\Orsak.Remoting.fsproj" />
    </ItemGroup>
</Project>
