<Project Sdk="Microsoft.NET.Sdk">
    <!-- A Fable app referencing Orsak as a package, as users would, rather than as a project -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <OrsakVersion Condition="'$(OrsakVersion)' == ''">0.0.0-fabletrial2</OrsakVersion>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="App.fs" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Orsak" Version="$(OrsakVersion)" />
    </ItemGroup>
</Project>
