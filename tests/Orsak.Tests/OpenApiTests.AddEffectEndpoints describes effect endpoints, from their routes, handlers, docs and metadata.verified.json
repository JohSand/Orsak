  "paths": {
    "/orders/{orderId}": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "Gets an order, with its lines.",
        "description": "The lines are in the order they were added. See OrderLine.",
        "operationId": "getOrder",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "description": "The id of the order.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The order.",
            "content": {
              "application/json": {
                "schema": {
                  "required": [
                    "id",
                    "customer",
                    "lines",
                    "note"
                  ],
                  "type": "object",
                  "properties": {
                    "id": {
                      "pattern": "^-?(?:0|[1-9]\\d*)$",
                      "type": [
                        "integer",
                        "string"
                      ],
                      "format": "int32"
                    },
                    "customer": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "lines": {
                      "type": [
                        "null",
                        "array"
                      ],
                      "items": {
                        "required": [
                          "sku",
                          "quantity"
                        ],
                        "type": "object",
                        "properties": {
                          "sku": {
                            "type": [
                              "null",
                              "string"
                            ]
                          },
                          "quantity": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": [
                              "integer",
                              "string"
                            ],
                            "format": "int32"
                          }
                        }
                      }
                    },
                    "note": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No order has the id."
          }
        }
      },
      "delete": {
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "required": [
                    "id",
