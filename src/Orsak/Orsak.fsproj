<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net8.0; net10.0</TargetFrameworks>
		<RootNamespace>Orsak</RootNamespace>
	</PropertyGroup>

	<!-- Fable sets FABLE_COMPILER. It can't translate resumable code or ValueTask, so it compiles the Effect type and
	     eff from Fable/, and the Effect module and the base effects from the same files as .NET, whose .NET-only parts
	     are behind #if !FABLE_COMPILER; see experiments/Fable/README.md -->
	<ItemGroup Condition="'$(FABLE_COMPILER)' == 'true'">
		<Compile Include="Marker.fs" />
		<Compile Include="Fable\EffectBuilder.fs" />
		<Compile Include="Effect.fs" />
		<Compile Include="BaseEffects.fs" />
	</ItemGroup>
	<ItemGroup Condition="'$(FABLE_COMPILER)' != 'true'">
		<Compile Include="Marker.fs" />
		<Compile Include="ValueTaskBuilder.fs" />
		<Compile Include="Trampoline.fs" />
		<Compile Include="EffectBuilder.fs" />
		<Compile Include="EffSeqBuilder.fs" />
		<Compile Include="Effect.fs" />
		<Compile Include="BaseEffects.fs" />
		<Compile Include="Resilience.fs" />
		<Compile Include="ScopedEffect.fs" />
		<Compile Include="CancellationScope.fs" />
		<Compile Include="Effects\Database.fs" />
		<Compile Include="EffList.fs" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="FSharp.Core" Version="8.0.300" />
		<PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
	</ItemGroup>
	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>Orsak.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>
	<!-- A Fable project referencing the package compiles the sources in its fable/ folder: this project file, which
	     Fable evaluates with FABLE_COMPILER set, so it chooses the Fable files as above, and those files. -->
	<PropertyGroup>
		<PackageTags>$(PackageTags);fable;fable-library;fable-javascript</PackageTags>
	</PropertyGroup>
	<ItemGroup>
		<None Include="Orsak.fsproj;Marker.fs;Effect.fs;BaseEffects.fs" Pack="true" PackagePath="fable/" Visible="false" />
		<None Include="Fable\*.fs" Pack="true" PackagePath="fable/Fable/" Visible="false" />
	</ItemGroup>
</Project>