<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarnOn>3390;$(WarnOn)</WarnOn>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Include="Gen.fs" />
	  <Compile Include="Writer.fs" />
	  <Compile Include="Ast.fs" />
	  <Compile Include="Syntax.fs" />
	  <Compile Include="EffectGen.fs" />
	  <Compile Include="RunnerGen.fs" />
	  <Compile Include="EnvironmentGen.fs" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="build\Orsak.Myriad.InTest.props">
			<Pack>false</Pack>
			<PackagePath>%(Identity)</PackagePath>
			<Visible>true</Visible>
		</Content>

		<Content Include="build\Orsak.Myriad.props">
			<Pack>true</Pack>
			<PackagePath>%(Identity)</PackagePath>
			<Visible>true</Visible>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Myriad.Core" Version="1.0.0" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Update="FSharp.Core" Version="9.0.303" />
	</ItemGroup>

	<Import Project="build/Orsak.Myriad.props" />

</Project>
