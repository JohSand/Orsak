<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net8.0; net6.0</TargetFrameworks>
        <RootNamespace>Orsak.AspNetCore</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="Throwhelpers.fs" />
        <Compile Include="BackgroundWorker.fs" />
        <Compile Include="Diagnostics.fs" />
        <Compile Include="EndpointRouting.fs" />
        <Compile Include="EndpointRoutingV2.fs" />
    </ItemGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Orsak\Orsak.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FSharp.Core" Version="8.0.300" />
        <PackageReference Include="FastExpressionCompiler.LightExpression" Version="5.4.1" />
        <PackageReference Update="DotNet.ReproducibleBuilds" Version="2.0.5">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>
</Project>
