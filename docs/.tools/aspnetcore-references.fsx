// Writes docs/.generated/aspnetcore.fsx, which references the ASP.NET Core shared framework, for the docs' scripts to
// #load. Scripts can't reference a shared framework through a package, so the generated script references its
// assemblies by path, for the ASP.NET Core version matching the .NET runtime that runs this script.
//
//     dotnet fsi docs/.tools/aspnetcore-references.fsx
//
// Run it again after changing the .NET SDK. The generated script is specific to the machine, and ignored by git.
open System.IO
open System.Runtime.InteropServices

let netCoreDir = RuntimeEnvironment.GetRuntimeDirectory() |> Path.TrimEndingDirectorySeparator
let version = Path.GetFileName netCoreDir

let aspNetCoreDir =
    Path.Combine(netCoreDir, "..", "..", "Microsoft.AspNetCore.App", version) |> Path.GetFullPath

if not (Directory.Exists aspNetCoreDir) then
    failwith $"ASP.NET Core {version} isn't installed, it was expected in {aspNetCoreDir}"

let lines = [
    "// Generated by docs/.tools/aspnetcore-references.fsx, for this machine."
    $"#I @\"{aspNetCoreDir}\""
    for dll in Directory.GetFiles(aspNetCoreDir, "*.dll") |> Array.sort do
        let name = Path.GetFileName dll
        // the one native library in the folder, for hosting in IIS
        if name <> "aspnetcorev2_inprocess.dll" then
            $"#r \"{name}\""
]

let target =
    Path.Combine(__SOURCE_DIRECTORY__, "..", ".generated", "aspnetcore.fsx") |> Path.GetFullPath

Directory.CreateDirectory(Path.GetDirectoryName target) |> ignore
File.WriteAllLines(target, lines)
printfn $"Wrote {target}, for ASP.NET Core {version}"
