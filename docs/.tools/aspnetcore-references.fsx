// Writes docs/.generated/aspnetcore.fsx, which references the ASP.NET Core shared framework, for the docs' scripts to
// #load. Scripts can't reference a shared framework through a package, so the generated script references its
// assemblies by path, for the ASP.NET Core version matching the .NET runtime that runs this script.
//
//     dotnet fsi docs/.tools/aspnetcore-references.fsx
//
// Run it again after changing the .NET SDK. The generated script is specific to the machine, and ignored by git.
open System.IO
open System.Runtime.InteropServices

let netCoreDir = RuntimeEnvironment.GetRuntimeDirectory() |> Path.TrimEndingDirectorySeparator
let version = Path.GetFileName netCoreDir

let aspNetCoreRoot =
    Path.Combine(netCoreDir, "..", "..", "Microsoft.AspNetCore.App") |> Path.GetFullPath

// The runtime can be newer than any ASP.NET Core installed with it: setup-dotnet installs the latest LTS runtime on
// its own, without ASP.NET Core. Then the newest ASP.NET Core of the same major and minor version is used, which
// patch compatibility lets the runtime load.
let aspNetCoreDir =
    let exact = Path.Combine(aspNetCoreRoot, version)
    let runtimeVersion = System.Version.Parse version

    let sameMinor () =
        if Directory.Exists aspNetCoreRoot then
            Directory.GetDirectories aspNetCoreRoot
            |> Array.choose (fun dir ->
                match System.Version.TryParse(Path.GetFileName dir) with
                | true, v when v.Major = runtimeVersion.Major && v.Minor = runtimeVersion.Minor -> Some(v, dir)
                | _ -> None)
            |> Array.sortDescending
            |> Array.tryHead
            |> Option.map snd
        else
            None

    if Directory.Exists exact then
        exact
    else
        match sameMinor () with
        | Some dir -> dir
        | None -> failwith $"ASP.NET Core {version} isn't installed, nor any {runtimeVersion.Major}.{runtimeVersion.Minor}.x, in {aspNetCoreRoot}"

let lines = [
    "// Generated by docs/.tools/aspnetcore-references.fsx, for this machine."
    $"#I @\"{aspNetCoreDir}\""
    for dll in Directory.GetFiles(aspNetCoreDir, "*.dll") |> Array.sort do
        let name = Path.GetFileName dll
        // the one native library in the folder, for hosting in IIS
        if name <> "aspnetcorev2_inprocess.dll" then
            $"#r \"{name}\""
]

let target =
    Path.Combine(__SOURCE_DIRECTORY__, "..", ".generated", "aspnetcore.fsx") |> Path.GetFullPath

Directory.CreateDirectory(Path.GetDirectoryName target) |> ignore
File.WriteAllLines(target, lines)
printfn $"Wrote {target}, for ASP.NET Core {Path.GetFileName aspNetCoreDir} on runtime {version}"
