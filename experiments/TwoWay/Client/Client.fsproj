<Project Sdk="Microsoft.NET.Sdk">
    <!-- The client, compiled with Fable into ../out and bundled by Vite, keeping a connection the server calls it down -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="Change.fs" />
        <Compile Include="TodoList.fs" />
        <Compile Include="Detail.fs" />
        <Compile Include="AppModel.fs" />
        <Compile Include="Events.fs" />
        <Compile Include="OrsakReact.fs" />
        <Compile Include="Connection.fs" />
        <Compile Include="Views.fs" />
        <Compile Include="Main.fs" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Feliz" Version="3.4.0" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Shared\Shared.fsproj" />
    </ItemGroup>
</Project>
