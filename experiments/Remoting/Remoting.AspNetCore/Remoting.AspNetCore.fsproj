<Project Sdk="Microsoft.NET.Sdk">
    <!-- The prototype of the server side of Orsak.Remoting, for ASP.NET Core: .NET only -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="MapRemote.fs" />
    </ItemGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Remoting\Remoting.fsproj" />
    </ItemGroup>
</Project>
