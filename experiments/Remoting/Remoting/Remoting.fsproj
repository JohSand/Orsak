<Project Sdk="Microsoft.NET.Sdk">
    <!-- The prototype of Orsak.Remoting: the wire format and the client, compiled by .NET and by Fable -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="Json.fs" />
        <Compile Include="JsonCodec.fs" />
        <Compile Include="Protocol.fs" />
    </ItemGroup>
    <ItemGroup>
        <!-- for Emit, in the fetch transport Fable compiles -->
        <PackageReference Include="Fable.Core" Version="5.6.1" />
    </ItemGroup>
</Project>
