<Project Sdk="Microsoft.NET.Sdk">
    <!-- The .NET APIs that Effect's concurrency functions would need on Fable, run on Node.js -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="Concurrency.fs" />
    </ItemGroup>
</Project>
