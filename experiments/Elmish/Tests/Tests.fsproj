<Project Sdk="Microsoft.NET.Sdk">
    <!-- The app's update, run on .NET against a fake: Todos.fs doesn't depend on Elmish, so neither does this -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="..\App\Todos.fs" Link="Todos.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\..\samples\Remoting\Shared\Shared.fsproj" />
    </ItemGroup>
</Project>
