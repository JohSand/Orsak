<Project Sdk="Microsoft.NET.Sdk">
    <!-- The changes, run on .NET against a fake: the model and its changes depend on neither React nor Elmish, so
         neither does this -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="..\App\Change.fs" Link="Change.fs" />
        <Compile Include="..\App\TodoList.fs" Link="TodoList.fs" />
        <Compile Include="..\App\Detail.fs" Link="Detail.fs" />
        <Compile Include="..\App\AppModel.fs" Link="AppModel.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\..\samples\Remoting\Shared\Shared.fsproj" />
    </ItemGroup>
</Project>
