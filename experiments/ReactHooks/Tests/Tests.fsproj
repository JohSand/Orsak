<Project Sdk="Microsoft.NET.Sdk">
    <!-- The components, rendered with React in jsdom on Node.js against a fake whose calls the test answers: see the
         README. Compiled only with Fable. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="..\App\OrsakReact.fs" Link="OrsakReact.fs" />
        <Compile Include="..\App\Todos.fs" Link="Todos.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Feliz" Version="3.4.0" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\..\samples\Remoting\Shared\Shared.fsproj" />
    </ItemGroup>
</Project>
